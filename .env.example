# SWT3 AI Witness SDK (Go) -- Environment Variables
# Copy to .env and fill in your values.
# Get your API key: https://sovereign.tenova.io/signup
#
# NEVER commit .env files. Use Secrets Manager / Key Vault for production.

# Required for cloud mode
SWT3_API_KEY=axm_live_YOUR_KEY_HERE
SWT3_ENDPOINT=https://sovereign.tenova.io/api/v1/witness/batch

# Optional
SWT3_TENANT_ID=YOUR_TENANT_ID
SWT3_CLEARING_LEVEL=1
SWT3_AGENT_ID=
SWT3_SIGNING_KEY=
